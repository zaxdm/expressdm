<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo en la compilación de pruebas (debug): todo va cifrado (HTTPS), salvo el
  servidor de pruebas que corre en la PC de desarrollo dentro de la red local.
  La versión publicada usa la de src/main, que no deja nada sin cifrar.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- La PC de desarrollo en la red local -->
        <domain includeSubdomains="false">192.168.15.2</domain>
        <!-- El emulador de Android hablando con la PC que lo aloja -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Con "adb reverse", el teléfono alcanza la PC por localhost -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
