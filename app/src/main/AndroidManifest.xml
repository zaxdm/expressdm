<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ubicación: para centrar el mapa en el usuario. La app funciona sin ella. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Descarga de teselas de OpenStreetMap y llamadas a la API de Gemini -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Grabación de recorridos: el servicio sigue vivo con la pantalla apagada -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Aviso de bajada: vibra al llegar a la parada, si el usuario lo deja encendido -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Aviso de bajada con la app cerrada y la pantalla apagada: mantener el
      teléfono atento mientras dura, y poder pedirle al usuario que el ahorro de
      batería no cierre la app.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Voz (Premium): preguntarle al asistente hablando. La app funciona sin él. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Premium: al llegar, un SMS desde la línea del usuario a quien él eligió,
      aunque no tenga internet. Se pide solo al activarlo en Ajustes.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Pedir SMS no deja la app fuera de las tablets sin línea: ahí ese aviso no se ofrece. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Actualizarse sola: abrir el instalador con la versión nueva que la app descarga. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Para saber si el teléfono tiene reconocimiento de voz y poder usarlo. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ExpresdmApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Expresdm">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Los enlaces que la gente comparte (https://…/ruta/<id>) abren la
              ficha de ese micro. Android solo los manda aquí sin preguntar si
              la web publica /.well-known/assetlinks.json con la firma de la app.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="${webHost}"
                    android:pathPrefix="/ruta/"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          Presta archivos de la app a otras: a la cámara, donde dejar la foto de
          una alerta; al instalador de Android, la versión nueva descargada.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Avisos al momento de alertas nuevas. Solo trabaja si la app se compiló con Firebase. -->
        <service
            android:name=".tracking.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Graba el recorrido de una ruta nueva. No se exporta: solo lo arranca la app. -->
        <service
            android:name=".tracking.RouteRecorderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Aviso de llegada: sigue la ubicación hasta la parada donde se baja el usuario. -->
        <service
            android:name=".tracking.ArrivalAlarmService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- Cómo salió el SMS de «ya llegué», y su «Reintentar». Solo lo llaman la app y Android por ella. -->
        <receiver
            android:name=".tracking.ArrivalSmsReceiver"
            android:exported="false" />

        <!-- Viaje en vivo: manda por dónde va mientras el usuario lo comparte. -->
        <service
            android:name=".tracking.LiveTripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          Permite que AppCompat recuerde el idioma elegido en Android 12 y
          anteriores. En Android 13+ lo guarda el propio sistema.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
