<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Tema claro. values-night/themes.xml redefine este mismo nombre para el
      modo oscuro; ninguna pantalla referencia un color fijo, solo estos roles.
    -->
    <style name="Theme.Expresdm" parent="Theme.Material3.DayNight.NoActionBar">
        <!--
          Negro: lo que se lee y se marca (enlaces, opciones elegidas). El
          amarillo de marca no sirve de texto sobre blanco, así que los rellenos
          amarillos se piden aparte con @color/brand y aquí queda su versión
          suave para los fondos.
        -->
        <item name="colorPrimary">@color/stone_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/yellow_100</item>
        <item name="colorOnPrimaryContainer">@color/amber_900</item>

        <!-- Ámbar: acentos que tienen que leerse -->
        <item name="colorSecondary">@color/amber_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/yellow_100</item>
        <item name="colorOnSecondaryContainer">@color/amber_900</item>

        <!-- Amarillo: el de la marca, tal cual -->
        <item name="colorTertiary">@color/yellow_500</item>
        <item name="colorOnTertiary">@color/stone_900</item>
        <item name="colorTertiaryContainer">@color/yellow_100</item>
        <item name="colorOnTertiaryContainer">@color/amber_900</item>

        <!-- Blanco y piedra: fondo, tarjetas y texto -->
        <item name="android:colorBackground">@color/stone_50</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/stone_900</item>
        <item name="colorSurfaceVariant">@color/stone_100</item>
        <item name="colorOnSurfaceVariant">@color/stone_500</item>
        <item name="colorOutline">@color/stone_200</item>
        <item name="colorOutlineVariant">@color/stone_200</item>

        <!--
          Las superficies elevadas (barra de abajo, hojas, diálogos, campos)
          usan estos roles. Sin ellos Material pone grises y lilas suyos que no
          son de la marca; y sin quitar el tinte, la elevación oscurece todo.
        -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/stone_50</item>
        <item name="colorSurfaceContainerHighest">@color/stone_100</item>
        <item name="colorSurfaceBright">@color/white</item>
        <item name="colorSurfaceDim">@color/stone_100</item>

        <item name="android:statusBarColor">@color/stone_50</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Letra de Subo en toda la app (ver font/subo_sans.xml) -->
        <item name="fontFamily">@font/subo_sans</item>
        <item name="android:fontFamily">@font/subo_sans</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Expresdm.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Expresdm.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Expresdm.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Expresdm.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Expresdm.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Expresdm.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Expresdm.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Expresdm.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Expresdm.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Expresdm.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Expresdm.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Expresdm.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Expresdm.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Expresdm.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Expresdm.LabelSmall</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Expresdm.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Expresdm.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Expresdm.Large</item>

        <item name="materialCardViewStyle">@style/Widget.Expresdm.Card</item>
        <item name="floatingActionButtonStyle">@style/Widget.Expresdm.Fab</item>
        <item name="bottomNavigationStyle">@style/Widget.Expresdm.BottomNav</item>
    </style>

    <style name="ShapeAppearance.Expresdm.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.Expresdm.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.Expresdm.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>
    <!-- Recorta en círculo, como la foto de perfil -->
    <style name="ShapeAppearance.Expresdm.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
