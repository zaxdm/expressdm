<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tarjetas: superficie plana con borde fino, como en el diseño -->
    <style name="Widget.Expresdm.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.Expresdm.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/brand</item>
        <item name="tint">@color/on_brand</item>
    </style>

    <style name="Widget.Expresdm.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Expresdm.NavIndicator</item>
        <item name="itemIconTint">@color/bottom_nav_icon</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
    </style>

    <!-- La pestaña activa: una pastilla del amarillo de marca -->
    <style name="Widget.Expresdm.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand</item>
    </style>

    <!-- Tipografía -->
    <style name="TextAppearance.Expresdm.SectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Expresdm.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Expresdm.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Insignia circular con la letra de la ruta -->
    <style name="Widget.Expresdm.RouteBadge" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Opción de una lista de ajustes -->
    <style name="Widget.Expresdm.Choice" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Interruptor de una lista de ajustes: el texto a la izquierda, el botón a la derecha -->
    <style name="Widget.Expresdm.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="switchPadding">16dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Etiqueta en mayúsculas encima de cada tarjeta de Ajustes -->
    <style name="Widget.Expresdm.SettingsLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Expresdm.SectionLabel</item>
    </style>

    <!-- Tarjeta que agrupa las filas de una sección de Ajustes -->
    <style name="Widget.Expresdm.SettingsCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="cardCornerRadius">22dp</item>
    </style>

    <!-- Línea entre filas de una tarjeta de Ajustes -->
    <style name="Widget.Expresdm.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">?attr/colorOutline</item>
    </style>

    <!-- Aclaración pequeña debajo de una tarjeta de Ajustes -->
    <style name="Widget.Expresdm.SettingsNote" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Expresdm.Body</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Cuadro de color de la muestra de paleta -->
    <style name="Widget.Expresdm.Swatch" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_swatch</item>
    </style>

    <!--
      Botón principal: una pastilla. De día es negra con el texto blanco, como
      en la web; de noche, amarilla con el texto negro (colorPrimary cambia).
    -->
    <style name="Widget.Expresdm.ButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
      Acciones del destino elegido: cuatro botones iguales en una fila, con el
      icono encima del nombre, para que quepan todos sin deslizar.
    -->
    <style name="Widget.Expresdm.PlaceAction" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">16dp</item>
        <item name="icon">@null</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">2dp</item>
        <item name="iconSize">20dp</item>
    </style>

</resources>
