<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Modo oscuro. Mismo nombre que el tema claro: Android elige este cuando el
      sistema (o el ajuste de la app) está en oscuro.

      Sobre negro el amarillo sí se lee, así que aquí también hace de color
      principal para textos y marcas.
    -->
    <style name="Theme.Expresdm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/yellow_500</item>
        <item name="colorOnPrimary">@color/ink_950</item>
        <item name="colorPrimaryContainer">@color/amber_900</item>
        <item name="colorOnPrimaryContainer">@color/yellow_100</item>

        <item name="colorSecondary">@color/yellow_300</item>
        <item name="colorOnSecondary">@color/ink_950</item>
        <item name="colorSecondaryContainer">@color/amber_900</item>
        <item name="colorOnSecondaryContainer">@color/yellow_100</item>

        <item name="colorTertiary">@color/yellow_500</item>
        <item name="colorOnTertiary">@color/ink_950</item>
        <item name="colorTertiaryContainer">@color/amber_900</item>
        <item name="colorOnTertiaryContainer">@color/yellow_100</item>

        <item name="android:colorBackground">@color/ink_950</item>
        <item name="colorSurface">@color/ink_900</item>
        <item name="colorOnSurface">@color/paper_100</item>
        <item name="colorSurfaceVariant">@color/ink_800</item>
        <item name="colorOnSurfaceVariant">@color/stone_400</item>
        <item name="colorOutline">@color/ink_700</item>
        <item name="colorOutlineVariant">@color/ink_700</item>

        <!-- Las superficies elevadas, con los negros de la marca (ver el tema claro). -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurfaceContainerLowest">@color/ink_950</item>
        <item name="colorSurfaceContainerLow">@color/ink_900</item>
        <item name="colorSurfaceContainer">@color/ink_900</item>
        <item name="colorSurfaceContainerHigh">@color/ink_800</item>
        <item name="colorSurfaceContainerHighest">@color/ink_700</item>
        <item name="colorSurfaceBright">@color/ink_800</item>
        <item name="colorSurfaceDim">@color/ink_950</item>

        <item name="android:statusBarColor">@color/ink_950</item>
        <item name="android:navigationBarColor">@color/ink_900</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Expresdm.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Expresdm.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Expresdm.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Expresdm.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Expresdm.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Expresdm.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Expresdm.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Expresdm.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Expresdm.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Expresdm.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Expresdm.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Expresdm.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Expresdm.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Expresdm.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Expresdm.LabelSmall</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Expresdm.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Expresdm.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Expresdm.Large</item>

        <item name="materialCardViewStyle">@style/Widget.Expresdm.Card</item>
        <item name="floatingActionButtonStyle">@style/Widget.Expresdm.Fab</item>
        <item name="bottomNavigationStyle">@style/Widget.Expresdm.BottomNav</item>
    </style>

</resources>
