<?xml version="1.0" encoding="utf-8"?>
<!--
  Letra de Subo: Plus Jakarta Sans. Solo dos pesos, como en la guía de estilo:
  el texto normal sale en 500 (se lee bien en movimiento) y todo lo que va en
  negrita, en 800 (títulos, precios, botones).
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/plus_jakarta_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/plus_jakarta_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/plus_jakarta_sans_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/plus_jakarta_sans_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
