<?xml version="1.0" encoding="utf-8"?>
<!-- Un punto de «Nosotros»: el icono en su cuadro amarillo suave, el título y el texto entero. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/pointIcon"
        style="@style/Widget.Expresdm.SettingsIcon"
        tools:src="@drawable/ic_map" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/pointTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Perfil.RowTitle"
            android:textSize="14sp"
            tools:text="Rutas y paraderos" />

        <TextView
            android:id="@+id/pointBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:textAppearance="@style/TextAppearance.Perfil.Support"
            tools:text="Por dónde pasa cada micro, cuánto cuesta y dónde subir." />
    </LinearLayout>
</LinearLayout>
