<?xml version="1.0" encoding="utf-8"?>
<!--
  Nosotros: quiénes hacen Subo, qué hace la app, lo que no va a cambiar y cómo
  escribirnos. Los puntos de cada tarjeta los pone AboutFragment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Perfil.CircleButton"
            android:contentDescription="@string/perfil_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="@string/about_title"
            android:textAppearance="@style/TextAppearance.Perfil.Title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/aboutScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- La presentación, en la tarjeta tinta con el amarillo de la marca -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/colorOnSurface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_about_tag"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="@string/about_tag"
                        android:textColor="#15171C"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/about_headline"
                        android:textColor="?attr/colorSurface"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.85"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/about_intro"
                        android:textColor="?attr/colorSurface"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- El equipo -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:text="@string/about_team_label" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:id="@+id/teamPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_settings"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Lo que hace Subo -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:text="@string/about_what_label" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:id="@+id/whatPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_settings"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Lo que no va a cambiar -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:text="@string/about_promises_label" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:id="@+id/promisePoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_settings"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/perfil_bg_info"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:text="@string/about_note"
                android:textColor="@color/perfil_info_text"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAboutContact"
                style="@style/Widget.Expresdm.ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/about_contact"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_send"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

            <TextView
                android:id="@+id/aboutVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Perfil.Support"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
