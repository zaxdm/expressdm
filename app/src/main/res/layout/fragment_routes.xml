<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- El mapa ocupa toda la pantalla: es lo primero que ve el usuario -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Arriba del mapa: la entrada a "¿A dónde vas?" y, si se graba una ruta, su barra -->
    <LinearLayout
        android:id="@+id/topArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_brand_badge">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_place"
                        app:tint="@color/on_brand" />
                </FrameLayout>

                <!-- No se escribe aquí: al tocar se abre la hoja para elegir salida y destino -->
                <TextView
                    android:id="@+id/searchText"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:hint="@string/search_hint"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    tools:text="Mi ubicación → Real Plaza Trujillo" />

                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_clear"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurface"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Grabación de una ruta nueva en curso -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/recordingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <View
                    android:id="@+id/recordingDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_circle_badge"
                    android:backgroundTint="@color/alert_accident" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/recordingTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Grabando ruta" />

                    <TextView
                        android:id="@+id/recordingSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="12sp"
                        tools:text="2,4 km · 12 min · 86 puntos" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnDiscardRecording"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/recording_discard"
                    android:src="@drawable/ic_delete"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinishRecording"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:backgroundTint="?attr/colorSecondary"
                    tools:text="Finalizar y guardar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Aviso de llegada activo; al tocarlo se vuelve a ver la ruta -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/arrivalBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrival_alarm"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/arrivalBarText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Aviso de llegada · Plaza de Armas · faltan 2,3 km" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelArrival"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arrival_action_cancel" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          La voz en el mapa: la esfera en pequeño y lo que se escucha o se dice.
          Solo aparece mientras se habla con Subo.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/voiceBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/voice_stage"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="4dp">

                <com.peru.expresdm.voice.VoiceOrbView
                    android:id="@+id/voiceBarOrb"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/voiceBarText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/voice_stage_text"
                    android:textSize="14sp"
                    tools:text="¿A dónde quieres ir?" />

                <ImageButton
                    android:id="@+id/btnCloseVoice"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_stop"
                    android:src="@drawable/ic_close"
                    app:tint="@color/voice_stage_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Eligiendo en el mapa dónde bajarse, sobre el recorrido del micro -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pickCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrival_alarm"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:id="@+id/pickText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Toca el mapa donde te bajas, sobre el recorrido" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickConfirm"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arrival_pick_confirm"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/btnPickClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/arrival_pick_close"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/colorOnSecondaryContainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- La vista de calle: la mitad de arriba, con el mapa debajo. Su alto lo pone RoutesFragment. -->
    <include
        android:id="@+id/streetPane"
        layout="@layout/view_street_pane"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="top"
        android:elevation="8dp"
        android:visibility="gone" />

    <!--
      Hoja deslizable sobre el mapa: rutas cercanas, lugares buscados o la ruta
      elegida. Tiene tres alturas: mínima (solo el título, para ver el mapa),
      de reposo (el carrusel) y arriba (la lista entera). Las dos primeras las
      ajusta RoutesFragment al contenido.
    -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        app:behavior_expandedOffset="88dp"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.5"
        app:behavior_hideable="false"
        app:behavior_peekHeight="120dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ===== Lista: rutas cercanas, lugares encontrados o micros que pasan por un lugar ===== -->
        <LinearLayout
            android:id="@+id/listContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sheetLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Expresdm.SectionLabel"
                        tools:text="CERCA DE TI" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddRoute"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="40dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp"
                        android:text="@string/add_route"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_add"
                        app:iconSize="18dp" />

                    <ImageButton
                        android:id="@+id/btnClosePlace"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/place_close"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/sheetTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Expresdm.SectionTitle"
                        tools:text="Rutas cercanas" />

                    <TextView
                        android:id="@+id/routeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_surface"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="3 opciones" />
                </LinearLayout>

                <!-- Qué muestra la lista y, si falta la ubicación, cómo arreglarlo -->
                <LinearLayout
                    android:id="@+id/statusRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingEnd="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/statusIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_my_location"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textAppearance="@style/TextAppearance.Expresdm.Body"
                        android:textSize="13sp"
                        tools:text="A menos de 1,5 km de ti" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStatusAction"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:text="Activar"
                        tools:visibility="visible" />
                </LinearLayout>

                <!--
                  Con un destino elegido (tocando el mapa o buscándolo): lo mismo
                  que ofrece el panel de una ruta, para el viaje que se ve en el
                  mapa, y guardar el lugar como favorito.
                -->
                <LinearLayout
                    android:id="@+id/placeActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJourneyArrival"
                        style="@style/Widget.Expresdm.PlaceAction"
                        android:text="@string/journey_arrival_enable"
                        app:icon="@drawable/ic_arrival_alarm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJourneyDetail"
                        style="@style/Widget.Expresdm.PlaceAction"
                        android:text="@string/journey_detail"
                        app:icon="@drawable/ic_info" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJourneyShare"
                        style="@style/Widget.Expresdm.PlaceAction"
                        android:text="@string/journey_share"
                        app:icon="@drawable/ic_send" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSavePlace"
                        style="@style/Widget.Expresdm.PlaceAction"
                        android:text="@string/place_save"
                        app:icon="@drawable/ic_star_outline" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/searchProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackCornerRadius="2dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/routesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_route" />

                <TextView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/empty_routes"
                    android:textAppearance="@style/TextAppearance.Expresdm.Body"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===== Ruta elegida, trazada en el mapa ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/routePanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/selectedBadge"
                        style="@style/Widget.Expresdm.RouteBadge"
                        android:background="@drawable/bg_circle_badge"
                        tools:text="A" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:id="@+id/selectedName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Expresdm.SectionTitle"
                            tools:text="California" />

                        <TextView
                            android:id="@+id/selectedSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Expresdm.Body"
                            tools:text="El Porvenir — Huanchaco" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCloseRoute"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/selected_close"
                        android:src="@drawable/ic_close"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- Por dónde caminar hasta la parada -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/walkCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/petrol"
                    app:cardCornerRadius="18dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_walk"
                            app:tint="@color/on_petrol" />

                        <TextView
                            android:id="@+id/walkText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:textColor="@color/on_petrol"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Camina 540 m · 8 min hasta Av. España" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWalkAction"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_petrol"
                            android:visibility="gone"
                            tools:text="Activar" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Solo en las rutas que grabó quien usa el teléfono -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteRoute"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/route_delete"
                    android:textColor="@color/alert_accident"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Alertas vigentes cerca del recorrido; al tocar, abre la pestaña de alertas -->
                <TextView
                    android:id="@+id/alertsOnRoute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:textColor="@color/alert_accident"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_alert_danger"
                    app:drawableTint="@color/alert_accident"
                    tools:text="2 alertas activas en el recorrido"
                    tools:visibility="visible" />

                <!-- Aviso de llegada: avisa al acercarse a la parada -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/arrivalCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    app:cardCornerRadius="18dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrival_alarm"
                            app:tint="?attr/colorOnSecondaryContainer" />

                        <TextView
                            android:id="@+id/arrivalText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textSize="13sp"
                            tools:text="Avísame al llegar: una notificación sin sonido cerca de mi parada" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnArrivalAction"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Activar" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- La ficha del micro: foto, horario, tarifas y calificaciones -->
                <include
                    android:id="@+id/routeInfo"
                    layout="@layout/view_route_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/approxNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/selected_approximate"
                    android:textAppearance="@style/TextAppearance.Expresdm.Body"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="4dp"
                    android:text="@string/route_stops"
                    android:textAppearance="@style/TextAppearance.Expresdm.SectionTitle"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/stopsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="8dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!--
      Controles pegados a la hoja: la burbuja del asistente y el botón para
      volver al usuario. El contenedor no es tocable, así que el mapa sigue
      recibiendo los gestos en el hueco entre ambos.
    -->
    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_anchor="@id/sheet"
        android:layout_gravity="top|end"
        app:layout_anchorGravity="top|end">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/assistantBubble"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/assistant_bubble_label"
            android:text="@string/assistant_bubble_label"
            app:icon="@drawable/ic_assistant" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/my_location"
            app:srcCompat="@drawable/ic_my_location" />
    </LinearLayout>

    <!--
      El cuadradito que abre la vista de calle de lo que se ve en el mapa, como
      el de Google Maps. El relleno de abajo lo deja encima de la atribución.
    -->
    <FrameLayout
        android:id="@+id/streetViewHolder"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="46dp"
        app:layout_anchor="@id/sheet"
        app:layout_anchorGravity="top|start">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnStreetView"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:clickable="true"
            android:contentDescription="@string/street_view"
            android:focusable="true"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_streetview"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/street_view"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Las licencias de OpenStreetMap y del servicio de rutas exigen la atribución -->
    <TextView
        android:id="@+id/attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_pill_surface"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/map_attribution"
        android:textAppearance="@style/TextAppearance.Expresdm.Body"
        android:textSize="10sp"
        app:layout_anchor="@id/sheet"
        android:layout_gravity="top|start"
        app:layout_anchorGravity="top|start" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
