<?xml version="1.0" encoding="utf-8"?>
<!--
  La ficha de un micro en pantalla propia: arriba el mapa con su recorrido y,
  encima, la hoja arena con la ficha, que se desliza tapando el mapa.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- El recorrido en el color de la ruta; solo se mira, no se mueve -->
    <org.osmdroid.views.MapView
        android:id="@+id/detailMap"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="?attr/colorSurfaceVariant" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ficha_map_visible"
            android:background="@drawable/ficha_bg_sheet"
            android:elevation="8dp"
            android:minHeight="600dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/ficha_bg_handle" />

            <!-- Qué micro es -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detailBadge"
                    style="@style/Widget.Expresdm.RouteBadge"
                    android:background="@drawable/bg_brand_badge"
                    android:importantForAccessibility="no"
                    tools:backgroundTint="@color/route_accent_2"
                    tools:text="P" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/detailName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Expresdm.SectionTitle"
                        android:textSize="22sp"
                        tools:text="Prueba 02" />

                    <TextView
                        android:id="@+id/detailSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Ficha.Support"
                        tools:text="Avenida Fátima → Calle Ciro Alegría" />
                </LinearLayout>
            </LinearLayout>

            <!-- Las casillas, compartir, tarifas y calificaciones -->
            <include
                android:id="@+id/routeInfo"
                layout="@layout/view_route_info" />

            <!-- Por dónde pasa: RouteInfoPanel la pone debajo de compartir -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fichaStopsCard"
                style="@style/Widget.Ficha.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/route_stops"
                        android:textAppearance="@style/TextAppearance.Ficha.Section" />

                    <com.peru.expresdm.ui.routes.StopTimelineLayout
                        android:id="@+id/detailStops"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Volver: botón redondo blanco sobre el mapa -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ficha_bg_circle_button"
        android:contentDescription="@string/ficha_back"
        android:elevation="4dp"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_back"
        app:tint="?attr/colorOnSurface" />
</FrameLayout>
