<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/profile_settings"
        app:titleTextColor="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!--
          Cada sección es una etiqueta y una tarjeta. Las listas de opciones
          (distancia, sonido, tema, idioma) son filas que enseñan lo elegido y
          abren un selector: así la pantalla no se llena de botones.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp">

            <!-- Aviso al llegar -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:layout_marginTop="4dp"
                android:text="@string/settings_arrival_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <include
                        android:id="@+id/rowArrivalDistance"
                        layout="@layout/item_setting_row" />

                    <View style="@style/Widget.Expresdm.SettingsDivider" />

                    <include
                        android:id="@+id/rowArrivalTone"
                        layout="@layout/item_setting_row" />

                    <View style="@style/Widget.Expresdm.SettingsDivider" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/arrivalVibration"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_arrival_vibration" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/arrivalSound"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_arrival_sound" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/arrivalVoice"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_arrival_voice" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/arrivalEarly"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_arrival_early" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tonePremiumNote"
                style="@style/Widget.Expresdm.SettingsNote"
                android:text="@string/settings_arrival_tone_premium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/customSoundsNote"
                style="@style/Widget.Expresdm.SettingsNote"
                android:text="@string/settings_arrival_tone_remove_hint"
                android:visibility="gone" />

            <!-- Para oír y sentir el aviso tal como quedó configurado arriba. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestArrival"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="52dp"
                android:text="@string/settings_arrival_test"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_arrival_alarm"
                app:iconGravity="textStart" />

            <!-- Voz (Premium) -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:text="@string/settings_voice_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/voiceWake"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_voice_wake" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/voiceGuide"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_voice_guide" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/voiceAnswers"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_voice_answers" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.Expresdm.SettingsNote"
                android:text="@string/settings_voice_note" />

            <!-- Notificaciones -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:text="@string/settings_notifications_label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp">

                    <!-- Avisar de lo que se reporta cerca, aunque la app esté cerrada -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/alertNotifications"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_alert_notifications" />

                    <View style="@style/Widget.Expresdm.SettingsDivider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:text="@string/settings_alert_types"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                    <!-- Un chip por tipo de alerta; los pone SettingsFragment. -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/alertTypesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.Expresdm.SettingsNote"
                android:text="@string/settings_alert_types_note" />

            <!-- Apariencia e idioma -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:text="@string/settings_appearance" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <include
                        android:id="@+id/rowTheme"
                        layout="@layout/item_setting_row" />

                    <View style="@style/Widget.Expresdm.SettingsDivider" />

                    <include
                        android:id="@+id/rowLanguage"
                        layout="@layout/item_setting_row" />

                    <View style="@style/Widget.Expresdm.SettingsDivider" />

                    <!-- Muestra de la paleta, para ver el efecto del tema -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="12dp">

                        <View
                            android:id="@+id/swatchPrimary"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchTertiary"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchSecondary"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchNeutral"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchSurface"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchInk"
                            style="@style/Widget.Expresdm.Swatch" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.Expresdm.SettingsNote"
                android:text="@string/settings_language_note" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
