<?xml version="1.0" encoding="utf-8"?>
<!--
  Ajustes, como en la maqueta: botón redondo de volver y título grande; cada
  sección es un rótulo gris en mayúsculas y una tarjeta blanca con filas.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Perfil.CircleButton"
            android:contentDescription="@string/perfil_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="@string/profile_settings"
            android:textAppearance="@style/TextAppearance.Perfil.Title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Aviso al llegar -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:layout_marginTop="10dp"
                android:text="@string/settings_arrival_label" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_settings"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/rowArrivalDistance"
                        layout="@layout/item_setting_row" />

                    <include
                        android:id="@+id/rowArrivalTone"
                        layout="@layout/item_setting_row" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/arrivalVibration"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_arrival_vibration" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/arrivalSound"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_arrival_sound" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/arrivalVoice"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_arrival_voice" />

                    <!-- El preaviso, con su etiqueta PREMIUM al lado del texto -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/arrivalEarlyLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp"
                            android:text="@string/perfil_settings_early"
                            android:textAppearance="@style/TextAppearance.Perfil.RowText" />

                        <TextView
                            style="@style/Widget.Perfil.Tag"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/perfil_tag_premium" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/arrivalEarly"
                            style="@style/Widget.Expresdm.Switch"
                            android:layout_width="wrap_content"
                            android:contentDescription="@string/settings_arrival_early"
                            android:paddingStart="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tonePremiumNote"
                style="@style/Widget.Expresdm.SettingsNote"
                android:text="@string/settings_arrival_tone_premium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/customSoundsNote"
                style="@style/Widget.Expresdm.SettingsNote"
                android:text="@string/settings_arrival_tone_remove_hint"
                android:visibility="gone" />

            <!-- Para oír y sentir el aviso tal como quedó configurado arriba. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestArrival"
                style="@style/Widget.Expresdm.ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/perfil_settings_test"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_arrival_alarm"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

            <!-- Voz, con su etiqueta PREMIUM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Expresdm.SettingsLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/perfil_settings_voice" />

                <TextView
                    style="@style/Widget.Perfil.Tag"
                    android:layout_marginStart="6dp"
                    android:text="@string/perfil_tag_premium" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_settings"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/voiceWake"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_voice_wake" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/voiceGuide"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_voice_guide" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/voiceAnswers"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/settings_voice_answers" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Caja informativa petróleo suave -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/perfil_bg_info"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:text="@string/settings_voice_note"
                android:textColor="@color/perfil_info_text"
                android:textSize="13sp" />

            <!-- Notificaciones -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:text="@string/settings_notifications_label" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="14dp">

                    <!-- Avisar de lo que se reporta cerca, aunque la app esté cerrada -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/alertNotifications"
                        style="@style/Widget.Expresdm.Switch"
                        android:text="@string/perfil_settings_alerts" />

                    <!-- Un chip por tipo de alerta, con su punto de color; los pone SettingsFragment. -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/alertTypesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_alert_types"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/settings_alert_types_note"
                        android:textAppearance="@style/TextAppearance.Perfil.Support"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Apariencia e idioma -->
            <TextView
                style="@style/Widget.Expresdm.SettingsLabel"
                android:text="@string/settings_appearance" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Expresdm.SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_settings"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- Tema: tres botones juntos, el elegido en tinta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_theme"
                            android:textAppearance="@style/TextAppearance.Perfil.RowText" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/themeToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/themeSystem"
                                style="@style/Widget.Perfil.Segment"
                                android:text="@string/perfil_theme_system" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/themeLight"
                                style="@style/Widget.Perfil.Segment"
                                android:text="@string/settings_theme_light" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/themeDark"
                                style="@style/Widget.Perfil.Segment"
                                android:text="@string/settings_theme_dark" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                    <include
                        android:id="@+id/rowLanguage"
                        layout="@layout/item_setting_row" />

                    <!-- Muestra de la paleta, para ver el efecto del tema -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="12dp">

                        <View
                            android:id="@+id/swatchPrimary"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchTertiary"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchSecondary"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchNeutral"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchSurface"
                            style="@style/Widget.Expresdm.Swatch" />

                        <View
                            android:id="@+id/swatchInk"
                            style="@style/Widget.Expresdm.Swatch" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.Expresdm.SettingsNote"
                android:text="@string/settings_language_note"
                tools:ignore="TextContrastCheck" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
