<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil, como en la maqueta: título con el botón de ajustes, quién eres, la
  tarjeta negra de Subo Premium, tu actividad en tres casillas, tus rutas
  favoritas y el menú. Abajo, la versión y de dónde salen los mapas.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Título y engranaje -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_title"
                android:textAppearance="@style/TextAppearance.Perfil.Title" />

            <ImageButton
                android:id="@+id/btnProfileSettings"
                style="@style/Widget.Perfil.CircleButton"
                android:contentDescription="@string/profile_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Quién eres -->
        <LinearLayout
            android:id="@+id/identityRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
              Con sesión, la foto o las iniciales; sin ella, la silueta. Con
              sesión se toca para cambiar el nombre o la foto.
            -->
            <FrameLayout
                android:id="@+id/avatarFrame"
                android:layout_width="60dp"
                android:layout_height="60dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_badge">

                    <ImageView
                        android:id="@+id/profileAvatarIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="@color/on_brand" />

                    <TextView
                        android:id="@+id/profileAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile_avatar"
                        android:gravity="center"
                        android:textColor="@color/on_brand"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="EZ"
                        tools:visibility="visible" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profilePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Expresdm.Circle" />
                </FrameLayout>

                <!-- El lápiz avisa de que el avatar se puede tocar -->
                <ImageView
                    android:id="@+id/avatarCamera"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_badge"
                    android:backgroundTint="@color/perfil_ink_card"
                    android:importantForAccessibility="no"
                    android:padding="5dp"
                    android:src="@drawable/ic_edit"
                    android:visibility="gone"
                    app:tint="@color/perfil_on_ink"
                    tools:visibility="visible" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/profile_guest"
                    android:textAppearance="@style/TextAppearance.Perfil.RowTitle"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/profileSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingTop="1dp"
                    android:text="@string/profile_guest_subtitle"
                    android:textAppearance="@style/TextAppearance.Perfil.Support" />
            </LinearLayout>

            <!-- Sin sesión, el botón invita a entrar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccount"
                style="@style/Widget.Expresdm.ButtonPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/account_sign_in"
                android:textSize="13sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Subo Premium: tarjeta negra -->
        <LinearLayout
            android:id="@+id/rowPremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/perfil_bg_ink_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/perfil_bg_tile_brand"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_star"
                app:tint="@color/on_brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_title"
                        android:textColor="@color/perfil_on_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/premiumBadge"
                        style="@style/Widget.Perfil.Tag"
                        android:layout_marginStart="8dp"
                        android:text="@string/premium_badge_active"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/premiumSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/perfil_on_ink_muted"
                    android:textSize="12sp"
                    tools:text="Hasta el 12 oct. 2027 · Ver beneficios" />
            </LinearLayout>

            <ImageView
                style="@style/Widget.Perfil.Chevron"
                app:tint="@color/brand" />
        </LinearLayout>

        <!-- Tu actividad -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/profile_activity"
            android:textAppearance="@style/TextAppearance.Perfil.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Perfil.TileCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/statRoutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="2" />

                    <TextView
                        android:id="@+id/statRoutesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stat_saved"
                        android:textAppearance="@style/TextAppearance.Perfil.Support"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Perfil.TileCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/statAlerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stat_alerts"
                        android:textAppearance="@style/TextAppearance.Perfil.Support"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Perfil.TileCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/statUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stat_used"
                        android:textAppearance="@style/TextAppearance.Perfil.Support"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/emptyActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingTop="8dp"
            android:paddingEnd="2dp"
            android:text="@string/profile_activity_empty"
            android:textAppearance="@style/TextAppearance.Perfil.Support"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Rutas favoritas, con cuántas son a la derecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_saved_routes"
                android:textAppearance="@style/TextAppearance.Perfil.Section" />

            <TextView
                android:id="@+id/favoritesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorSecondary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="2" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/favoritesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favoritesRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:itemCount="2"
                tools:listitem="@layout/item_perfil_route" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Sin favoritas: se explica de dónde saldrán -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/emptyFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardCornerRadius="18dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    style="@style/Widget.Expresdm.SettingsIcon"
                    android:src="@drawable/ic_nav_routes" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="@string/empty_favorites"
                    android:textAppearance="@style/TextAppearance.Perfil.Support" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Menú -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        style="@style/Widget.Perfil.MenuIcon"
                        android:src="@drawable/ic_settings" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="14dp"
                        android:text="@string/profile_settings"
                        android:textAppearance="@style/TextAppearance.Perfil.RowText" />

                    <ImageView style="@style/Widget.Perfil.Chevron" />
                </LinearLayout>

                <View style="@style/Widget.Expresdm.SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        style="@style/Widget.Perfil.MenuIcon"
                        android:src="@drawable/perfil_ic_help" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="14dp"
                        android:text="@string/perfil_menu_help"
                        android:textAppearance="@style/TextAppearance.Perfil.RowText" />

                    <ImageView style="@style/Widget.Perfil.Chevron" />
                </LinearLayout>

                <View
                    android:id="@+id/signOutDivider"
                    style="@style/Widget.Expresdm.SettingsDivider"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/rowSignOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        style="@style/Widget.Perfil.MenuIcon"
                        android:src="@drawable/ic_sign_out"
                        app:tint="@color/perfil_danger" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="14dp"
                        android:text="@string/account_sign_out"
                        android:textAppearance="@style/TextAppearance.Perfil.RowText"
                        android:textColor="@color/perfil_danger" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pie: versión y de dónde salen los mapas -->
        <TextView
            android:id="@+id/profileFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textAppearance="@style/TextAppearance.Perfil.Support"
            android:textSize="11sp"
            tools:text="Subo · Versión 1.5\nMapas y búsquedas de OpenStreetMap, un proyecto abierto y gratuito." />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
