<?xml version="1.0" encoding="utf-8"?>
<!--
  Una parada de "Por dónde pasa". El punto de la línea de tiempo no se dibuja
  aquí: stopNumber solo guarda su sitio y el color de la ruta, y StopTimelineLayout
  pinta encima los círculos y la línea que los une.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="42dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Sitio del punto; el número no se ve, pero sigue ahí para quien lo pida -->
    <TextView
        android:id="@+id/stopNumber"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:importantForAccessibility="no"
        android:textColor="@android:color/transparent"
        android:textSize="1sp"
        tools:text="4" />

    <TextView
        android:id="@+id/stopName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:textAppearance="@style/TextAppearance.Ficha.Row"
        tools:text="Avenida Fátima" />

    <TextView
        android:id="@+id/stopTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ficha_bg_tag"
        android:letterSpacing="0.04"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp"
        android:text="@string/selected_board_here"
        android:textColor="@color/on_brand"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
