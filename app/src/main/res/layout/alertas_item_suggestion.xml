<?xml version="1.0" encoding="utf-8"?>
<!-- Una pregunta de ejemplo del asistente: fila amarillo suave con pin y flecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/alertas_bg_round_14"
    android:backgroundTint="@color/alertas_soft_yellow"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/alertas_ic_pin"
        app:tint="@color/alertas_on_soft_yellow" />

    <TextView
        android:id="@+id/suggestionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Alertas.Strong"
        android:textSize="14sp"
        tools:text="¿Cómo llego a Huanchaco?" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/alertas_ic_chevron"
        app:tint="?attr/colorOnSurface" />
</LinearLayout>
