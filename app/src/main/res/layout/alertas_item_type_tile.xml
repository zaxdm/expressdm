<?xml version="1.0" encoding="utf-8"?>
<!-- Una casilla de la rejilla de tipos de "¿Qué está pasando?". -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Alertas.Tile"
    android:layout_width="0dp"
    android:layout_height="72dp"
    android:layout_weight="1"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:checkedIcon="@null">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/alertas_bg_round_12"
            android:importantForAccessibility="no"
            android:padding="11dp"
            tools:backgroundTint="@color/alert_traffic_soft"
            tools:src="@drawable/alertas_ic_traffic"
            tools:tint="@color/alert_traffic" />

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Alertas.Strong"
            android:textSize="14sp"
            tools:text="Tráfico" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
