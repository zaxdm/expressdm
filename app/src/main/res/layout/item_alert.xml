<?xml version="1.0" encoding="utf-8"?>
<!-- Una alerta vigente en la pestaña de alertas: tarjeta blanca con el icono del tipo en su cuadro. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Alertas.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- El icono en su color fuerte sobre el suave del mismo tipo -->
            <FrameLayout
                android:id="@+id/alertIconBg"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/alertas_bg_round_12"
                tools:backgroundTint="@color/alert_traffic_soft">

                <ImageView
                    android:id="@+id/alertIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/alertas_ic_traffic"
                    tools:tint="@color/alert_traffic" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/alertType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Alertas.Strong"
                    tools:text="Tráfico" />

                <TextView
                    android:id="@+id/alertMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Alertas.Support"
                    tools:text="Av. España · Hace 12 min · a 450 m" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnShowOnMap"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/alertas_bg_circle"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:contentDescription="@string/alert_show_on_map"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/alertas_ic_pin"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/alertComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Cola larga desde el óvalo, mejor tomar Av. América"
            tools:visibility="visible" />

        <!-- La foto, si quien avisó adjuntó una -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/alertPhoto"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Expresdm.Small" />

        <!-- Quién avisó y, si suele acertar, que es de confianza -->
        <TextView
            android:id="@+id/alertAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.Alertas.Support"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Ana María · Suele acertar"
            tools:visibility="visible" />

        <!-- Votos: "Ya no está" y "Sigue ahí", en pastillas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGone"
                style="@style/Widget.Alertas.VoteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alert_gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStillThere"
                style="@style/Widget.Alertas.VoteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:backgroundTint="@color/alertas_soft_yellow"
                app:strokeWidth="0dp"
                tools:text="Sigue ahí · 3" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
