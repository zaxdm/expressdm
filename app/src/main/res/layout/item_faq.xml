<?xml version="1.0" encoding="utf-8"?>
<!--
  Una pregunta de Soporte: al tocarla se despliega la respuesta. Van todas
  juntas en una tarjeta, separadas por una línea, como las filas de Ajustes.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/faqQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="¿Cómo puedo guardar rutas?" />

        <ImageView
            android:id="@+id/faqChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <TextView
        android:id="@+id/faqAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingTop="10dp"
        android:textAppearance="@style/TextAppearance.Expresdm.Body"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="No hace falta marcarlas."
        tools:visibility="visible" />
</LinearLayout>
