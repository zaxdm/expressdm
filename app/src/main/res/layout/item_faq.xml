<?xml version="1.0" encoding="utf-8"?>
<!--
  Una pregunta de Ayuda: al tocarla se despliega la respuesta y el "+" gira.
  Van todas juntas en una tarjeta, separadas por una línea.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/faqQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="10dp"
            android:textAppearance="@style/TextAppearance.Perfil.RowTitle"
            android:textSize="14sp"
            tools:text="¿Cómo puedo guardar rutas?" />

        <ImageView
            android:id="@+id/faqChevron"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/perfil_bg_circle_soft"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_add"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <TextView
        android:id="@+id/faqAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingTop="10dp"
        android:paddingEnd="30dp"
        android:textAppearance="@style/TextAppearance.Perfil.Support"
        android:visibility="gone"
        tools:text="No hace falta marcarlas."
        tools:visibility="visible" />
</LinearLayout>
