<?xml version="1.0" encoding="utf-8"?>
<!--
  Una ruta favorita del perfil: la insignia cuadrada con su letra, el nombre y
  por dónde va; a la derecha, el pasaje y cuánto dura.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/routeRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/routeBadge"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/perfil_bg_route_badge"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:backgroundTint="#C2410C"
        tools:text="P" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/routeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Perfil.RowTitle"
            android:textSize="14sp"
            tools:text="Prueba 02" />

        <TextView
            android:id="@+id/routeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Perfil.Support"
            android:textSize="12sp"
            tools:text="Av. Fátima — Calle Ciro Alegría" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/routeFare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="S/ 1.00" />

        <TextView
            android:id="@+id/routeDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Perfil.Support"
            android:textSize="11sp"
            tools:text="14 min" />
    </LinearLayout>
</LinearLayout>
