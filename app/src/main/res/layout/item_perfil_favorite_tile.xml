<?xml version="1.0" encoding="utf-8"?>
<!--
  Una casilla de "Destinos favoritos": el icono en un círculo amarillo suave
  (un "+" si aún está libre) y su nombre. Si ya tiene lugar, se ve cuál.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tileCard"
    style="@style/Widget.Perfil.TileCard"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minHeight="78dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="12dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/perfil_bg_circle_soft"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_add"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Perfil.RowTitle"
            android:textSize="12sp"
            tools:text="Casa" />

        <TextView
            android:id="@+id/tileDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Perfil.Support"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="Av. Larco 123"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
