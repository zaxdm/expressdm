<?xml version="1.0" encoding="utf-8"?>
<!--
  Un lugar: reciente o encontrado con el buscador. El icono va en un cuadro
  gris, el nombre en negrita y la distancia en una pastilla gris.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/placeIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/perfil_bg_tile_neutral"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_place"
        app:tint="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/placeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Perfil.RowTitle"
            android:textSize="14sp"
            tools:text="Avenida Las Américas" />

        <TextView
            android:id="@+id/placeDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Perfil.Support"
            android:textSize="12sp"
            tools:text="Las Torres de San Borja, Moche" />
    </LinearLayout>

    <TextView
        android:id="@+id/placeDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/perfil_bg_pill_neutral"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="6.1 km" />
</LinearLayout>
