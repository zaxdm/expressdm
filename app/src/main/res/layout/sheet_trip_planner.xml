<?xml version="1.0" encoding="utf-8"?>
<!--
  "¿A dónde vas?", como en la maqueta: título y botón de cerrar; la tarjeta
  DESDE/HACIA con el punto, la línea punteada, el pin y el botón de
  intercambiar; la tarjeta petróleo para elegir en el mapa; recientes y
  destinos favoritos; y abajo, la fila para preguntarle al asistente.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/perfil_bg_sheet_sand"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/planner_title"
                android:textAppearance="@style/TextAppearance.Perfil.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/planner_subtitle"
                android:textAppearance="@style/TextAppearance.Perfil.Support" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClose"
            style="@style/Widget.Perfil.CircleButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/planner_close"
            android:padding="9dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Desde / hacia -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <!-- Salida, línea punteada y destino -->
            <LinearLayout
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="37dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/perfil_bg_origin_dot" />

                <ImageView
                    android:layout_width="2dp"
                    android:layout_height="41dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/perfil_rail_dotted" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_place"
                    app:tint="@color/brand" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/perfil_planner_from"
                    android:textAppearance="@style/TextAppearance.Perfil.Caps"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/originInput"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/perfil_planner_my_location"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Volver a salir desde donde estoy -->
                    <ImageButton
                        android:id="@+id/btnOriginHere"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/planner_origin_here"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_my_location"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant"
                        tools:visibility="visible" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:background="?attr/colorOutline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/perfil_planner_to"
                    android:textAppearance="@style/TextAppearance.Perfil.Caps"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/destinationInput"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/planner_destination_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="15sp" />

                    <!-- Buscar ya, sin esperar: también lo hace la tecla del teclado -->
                    <ImageButton
                        android:id="@+id/btnSearch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/planner_search"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_search"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwap"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/planner_swap"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/brand"
                app:icon="@drawable/ic_swap"
                app:iconSize="20dp"
                app:iconTint="@color/on_brand" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/searchProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="28dp"
        android:indeterminate="true"
        android:visibility="invisible"
        app:trackCornerRadius="2dp" />

    <!-- Solo cuando hay un destino elegido que confirmar (al intercambiar o al reabrir) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlan"
        style="@style/Widget.Expresdm.ButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:text="@string/planner_go"
        android:visibility="gone"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="end"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Sin nada escrito: atajos -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/idleContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Elegir en el mapa: tarjeta petróleo -->
                <LinearLayout
                    android:id="@+id/btnPickOnMap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/perfil_bg_petrol_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/perfil_bg_tile_on_dark"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_map"
                        app:tint="@color/brand" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/planner_pick_on_map"
                            android:textColor="@color/on_petrol"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/planner_pick_on_map_detail"
                            android:textColor="@color/perfil_on_petrol_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.Perfil.Chevron"
                        app:tint="@color/on_petrol" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recentsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="2dp"
                            android:text="@string/planner_recents"
                            android:textAppearance="@style/TextAppearance.Expresdm.SectionLabel" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearRecents"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="2dp"
                            android:text="@string/planner_recents_clear"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp">

                        <LinearLayout
                            android:id="@+id/recentsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:divider="@drawable/divider_settings"
                            android:orientation="vertical"
                            android:showDividers="middle" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="2dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:text="@string/planner_favorites"
                    android:textAppearance="@style/TextAppearance.Expresdm.SectionLabel" />

                <!-- Casillas de tres en fila; las pone TripPlannerSheet -->
                <LinearLayout
                    android:id="@+id/favoritesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/favoritesNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="2dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="2dp"
                    android:textAppearance="@style/TextAppearance.Perfil.Support"
                    android:textSize="12sp"
                    tools:text="Casa, trabajo, pareja… guarda todos los que quieras." />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Escribiendo o con resultados -->
        <LinearLayout
            android:id="@+id/resultsContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/resultsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:textAppearance="@style/TextAppearance.Expresdm.SectionLabel"
                tools:text="LUGARES" />

            <TextView
                android:id="@+id/resultsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="4dp"
                android:paddingEnd="18dp"
                android:textAppearance="@style/TextAppearance.Perfil.Support"
                tools:text="Elige el lugar correcto para ver cómo llegar" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/resultsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_place" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </FrameLayout>

    <!-- ¿No sabes la dirección? El asistente la busca contigo. -->
    <LinearLayout
        android:id="@+id/btnAskAssistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/perfil_bg_soft_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/perfil_bg_tile_brand"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/perfil_ic_chat"
            app:tint="@color/on_brand" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:text="@string/perfil_planner_ask"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            style="@style/Widget.Perfil.Chevron"
            app:tint="?attr/colorOnPrimaryContainer" />
    </LinearLayout>
</LinearLayout>
