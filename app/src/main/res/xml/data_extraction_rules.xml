<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia en la nube y paso a otro teléfono (Android 12 o posterior). La sesión
  (el token de la cuenta) no viaja: en el teléfono nuevo se vuelve a entrar.
  Ver https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="expresdm_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="expresdm_session.xml" />
    </device-transfer>
</data-extraction-rules>
