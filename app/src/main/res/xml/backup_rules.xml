<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de seguridad en Android 11 o anterior. La sesión (el token de la cuenta)
  no se copia: restaurada en otro teléfono, daría la cuenta abierta a quien lo
  tenga. Basta con volver a iniciar sesión.
  Ver https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="expresdm_session.xml" />
</full-backup-content>
